# Build output.
/target

# Staged for, and produced by, the MSI build. The installer source next to them is
# version-controlled; these are not.
/packaging/*.exe
/packaging/*.msi
/packaging/*.wixpdb

# Arch package build output (see packaging/arch).
/packaging/arch/pkg
/packaging/arch/src
/packaging/arch/*.pkg.tar.zst
/packaging/arch/*.log
